# Environment contract for Hasan Journal.
# Copy this file to `.env` and fill it in, or run `pnpm setup:local` to
# generate a `.env` with random local secrets automatically (never
# overwrites an existing `.env`).
#
# Values here are placeholders/documentation only. Never put real
# production secrets in a file tracked by Git.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# development | production | test
NODE_ENV=development

# Canonical public origin. Used for absolute URLs (RSS, sitemap, SEO,
# redirects) instead of trusting the request Host header.
# Local dev (host process): http://localhost:3000
# Production: https://your-real-domain.example (no localhost allowed)
PUBLIC_SITE_URL=http://localhost:3000

# Port the Next.js server binds to.
PORT=3000

# Long random string used by Payload to sign/encrypt auth tokens and
# cookies. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# `pnpm setup:local` generates this automatically for local dev.
PAYLOAD_SECRET=

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------

# From the host dev process (Next/Payload running on your machine, Postgres
# in Docker with a published port):
#   postgres://hasan:<password>@localhost:5432/hasan_journal
# From inside the app's own Docker container (Compose network, using the
# service name as hostname):
#   postgres://hasan:<password>@postgres:5432/hasan_journal
DATABASE_URI=postgres://hasan:changeme@localhost:5432/hasan_journal

# ---------------------------------------------------------------------------
# S3-compatible object storage (media)
# ---------------------------------------------------------------------------

# Local dev uses Garage (see docs/DECISIONS.md for why not MinIO).
# From the host dev process: http://localhost:3900
# From inside the app's own Docker container: http://garage:3900
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_BUCKET=hasan-journal-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Garage/MinIO-style endpoints need path-style bucket addressing
# (https://endpoint/bucket/key) instead of virtual-hosted-style.
S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# SMTP (password reset email)
# ---------------------------------------------------------------------------

# Local dev uses Mailpit (mail capture, never sends real email).
# From the host dev process: localhost:1025
# From inside the app's own Docker container: mailpit:1025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# Empty for local Mailpit capture. Required for a real production SMTP relay.
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=no-reply@localhost
SMTP_FROM_NAME=Hasan Journal

# ---------------------------------------------------------------------------
# Local-only test fixtures (never enable in production)
# ---------------------------------------------------------------------------

# Explicit opt-in switch read by `pnpm seed:demo`. Refuses to run unless
# NODE_ENV is not "production" AND this is exactly "true".
ALLOW_DEMO_SEED=false
