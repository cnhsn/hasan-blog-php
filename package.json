{
  "name": "hasan-journal",
  "version": "0.1.0",
  "private": true,
  "description": "Hasan's personal blog and project portfolio (Next.js + Payload CMS + PostgreSQL)",
  "license": "UNLICENSED",
  "engines": {
    "node": "24.19.0"
  },
  "packageManager": "pnpm@9.12.0",
  "type": "module",
  "scripts": {
    "setup:local": "node --env-file-if-exists=.env scripts/setup-local.mjs",
    "services:up": "docker compose -f compose.yaml up -d --wait",
    "services:down": "docker compose -f compose.yaml stop",
    "services:reset": "node scripts/services-reset.mjs",
    "db:migrate": "node --env-file=.env node_modules/payload/bin.js migrate",
    "db:migrate:create": "node --env-file=.env node_modules/payload/bin.js migrate:create",
    "admin:bootstrap": "node --env-file=.env node_modules/tsx/dist/cli.mjs scripts/admin-bootstrap.ts",
    "seed": "node --env-file=.env node_modules/tsx/dist/cli.mjs scripts/seed.ts",
    "seed:demo": "node --env-file=.env node_modules/tsx/dist/cli.mjs scripts/seed-demo.ts",
    "generate:types": "node --env-file=.env node_modules/payload/bin.js generate:types",
    "generate:importmap": "node --env-file=.env node_modules/payload/bin.js generate:importmap",
    "dev": "next dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --env-file=.env node_modules/vitest/vitest.mjs run",
    "test:watch": "node --env-file=.env node_modules/vitest/vitest.mjs",
    "test:e2e": "node --env-file=.env node_modules/@playwright/test/cli.js test",
    "build": "next build",
    "start": "next start",
    "backup": "node --env-file=.env node_modules/tsx/dist/cli.mjs scripts/backup.ts",
    "restore:check": "node --env-file=.env node_modules/tsx/dist/cli.mjs scripts/restore-check.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/email-nodemailer": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-s3": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "graphql": "16.14.2",
    "next": "16.3.6",
    "payload": "3.90.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.1"
  }
}
